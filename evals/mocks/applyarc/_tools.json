    {
      "name": "list_my_jobs",
      "title": "List my tracked jobs",
      "description": "List the jobs the user is tracking in ApplyArc with status, company, title and dates. Use when the user asks what they have applied to, what is in their pipeline, or needs a jobId. Optionally filter by status.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "status": {
            "description": "Only return jobs in this pipeline stage",
            "type": "string",
            "enum": [
              "wishlist",
              "applied",
              "interview",
              "offer",
              "rejected"
            ]
          },
          "limit": {
            "default": 25,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "save_job",
      "title": "Save a job to my tracker",
      "description": "Save a job posting to the user's ApplyArc tracker so it appears in their pipeline on applyarc.com. Ask for the job title and company if the user has not given them.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Job title"
          },
          "company": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Company name"
          },
          "description": {
            "description": "Full job description text (paste it for best results)",
            "type": "string",
            "maxLength": 50000
          },
          "location": {
            "type": "string",
            "maxLength": 200
          },
          "url": {
            "description": "Link to the job posting",
            "type": "string",
            "maxLength": 2000,
            "format": "uri"
          },
          "status": {
            "default": "wishlist",
            "description": "Pipeline stage",
            "type": "string",
            "enum": [
              "wishlist",
              "applied",
              "interview",
              "offer",
              "rejected"
            ]
          },
          "pay": {
            "description": "Salary or pay range as written in the posting",
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "title",
          "company"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "update_job_status",
      "title": "Move a job to another stage",
      "description": "Change the pipeline stage of a tracked job (for example from applied to interview). Use list_my_jobs first to find the jobId.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "minLength": 1,
            "description": "Id returned by list_my_jobs"
          },
          "status": {
            "type": "string",
            "enum": [
              "wishlist",
              "applied",
              "interview",
              "offer",
              "rejected"
            ]
          }
        },
        "required": [
          "jobId",
          "status"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "generate_for_job",
      "title": "Generate application content with ApplyArc",
      "description": "Run one of ApplyArc's AI career tools against a job using the user's stored resume profile. Tools: cover-letter, interview-prep, job-match (fit score and gaps), resume-optimizer, follow-up, thank-you, salary-negotiation, company-research, questions-to-ask, outreach-message. Use when the user wants application content for a specific job. Consumes one AI generation from the account's allowance; the result includes the remaining allowance.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "toolId": {
            "type": "string",
            "enum": [
              "cover-letter",
              "interview-prep",
              "job-match",
              "resume-optimizer",
              "follow-up",
              "thank-you",
              "salary-negotiation",
              "company-research",
              "questions-to-ask",
              "outreach-message"
            ],
            "description": "Which ApplyArc tool to run"
          },
          "job": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "Job title"
              },
              "company": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "Company name"
              },
              "description": {
                "description": "Full job description text (paste it for best results)",
                "type": "string",
                "maxLength": 50000
              },
              "location": {
                "type": "string",
                "maxLength": 200
              },
              "url": {
                "description": "Link to the job posting",
                "type": "string",
                "maxLength": 2000,
                "format": "uri"
              }
            },
            "required": [
              "title",
              "company"
            ],
            "description": "The job to generate for"
          },
          "notes": {
            "description": "Extra guidance from the user, such as tone or points to emphasise",
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "toolId",
          "job"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    }
  ]
}
