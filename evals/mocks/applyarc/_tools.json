      }
    },
    {
      "name": "check_usage",
      "title": "Check my AI generation allowance",
      "description": "Show how many AI generations the user has left this month on ApplyArc, whether they are on Pro, and when the allowance resets. Call this before an AI generation if the user asks about limits or after a limit error.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      },
      "annotations": {
        "readOnlyHint": true,
