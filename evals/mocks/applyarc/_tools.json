{
  "tools": [
    {
      "name": "rewrite_cv_bullet",
      "title": "Rewrite a CV bullet point",
      "description": "Rewrite one CV or resume bullet point and return a before/after strength score. Use when the user shares a single bullet and wants it stronger, more concise, quantified, or matched to a job description. No account needed; daily per-source limit applies.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "bulletText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600,
            "description": "The bullet point to rewrite, at least 3 words"
          },
          "mode": {
            "default": "power-up",
            "description": "add-numbers, power-up, match-job (needs jobDescription) or make-concise",
            "type": "string",
            "enum": [
              "add-numbers",
              "power-up",
              "match-job",
              "make-concise"
            ]
          },
          "role": {
            "description": "Role the bullet is for",
            "type": "string",
            "maxLength": 120
          },
          "jobDescription": {
            "description": "Job description text, required for match-job",
            "type": "string",
            "maxLength": 8000
          }
        },
        "required": [
          "bulletText"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "preview_cover_letter",
      "title": "Preview a cover letter",
      "description": "Draft a short cover letter from a pasted job description and a resume summary. Use when the user has no ApplyArc account connected or wants a quick draft without their stored profile. For a letter grounded in the stored CV and saved to the tracker, use generate_for_job instead.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "jobDescription": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000,
            "description": "Job description, at least 15 words"
          },
          "resumeSummary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000,
            "description": "Resume summary or key experience, at least 10 words"
          }
        },
        "required": [
          "jobDescription",
          "resumeSummary"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "prepare_star_answer",
      "title": "Build a STAR interview answer",
      "description": "Turn a behavioural interview question into a STAR structure with coaching prompts, an exemplar answer, what the interviewer listens for, and a common mistake. Use when the user is preparing for an interview question. No account needed.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "The interview question"
          },
          "vertical": {
            "default": "generic",
            "description": "Use nhs for NHS or UK healthcare roles",
            "type": "string",
            "enum": [
              "generic",
              "nhs"
            ]
          }
        },
        "required": [
          "question"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_my_profile",
      "title": "Get my ApplyArc profile",
      "description": "Return the signed-in user's stored ApplyArc resume profile (skills, experience summary, target roles). Use when the user asks for advice, tailoring, or a fit check and has not pasted a CV in this conversation.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
